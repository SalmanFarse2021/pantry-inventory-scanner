{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "devCommand": "vite --port $PORT",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|src/|shared/|@|node_modules/|__vite)[^.]*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sweep",
      "schedule": "5 8 * * *"
    }
  ]
}
